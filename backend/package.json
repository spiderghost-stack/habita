{
  "name": "habita-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API HaBiTa - gestion immobilière (MVP Phase 1)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
