# Copier ce fichier en .env pour le développement local (jamais commité)

# URL de connexion PostgreSQL — fournie par Render une fois la base créée
DATABASE_URL="postgresql://user:password@localhost:5432/habita?schema=public"

# Secret utilisé pour signer les tokens JWT — générer une valeur longue et aléatoire
# (ex: openssl rand -hex 32)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Port d'écoute de l'API (Render fournit sa propre variable PORT en prod)
PORT=4000

# URL du frontend, utilisée pour la configuration CORS
FRONTEND_URL="http://localhost:3000"

NODE_ENV="development"

# Envoi d'email pour les rappels de loyer (section 11 du cahier des
# charges). Sans ces variables, les rappels sont simplement affichés dans
# les logs au lieu d'être envoyés — voir MANUAL_STEPS.md. Fonctionne avec
# n'importe quel fournisseur SMTP standard (Brevo/Sendinblue, Mailgun,
# Gmail avec mot de passe d'application, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HaBiTa <no-reply@habita.app>"

# Secret partagé pour autoriser un service externe (cron Render,
# cron-job.org...) à déclencher l'envoi quotidien des rappels via
# POST /api/v1/notifications/run-global (en-tête x-cron-secret).
# Générer une valeur aléatoire, par exemple : openssl rand -hex 32
CRON_SECRET=""

# Upload de fichiers (photos de signalement, documents de contrat) via
# Cloudinary. Sans ces trois valeurs, l'upload est désactivé (erreur 503)
# mais le reste de l'application fonctionne normalement — voir MANUAL_STEPS.md.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
